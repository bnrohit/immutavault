[Unit]
Description=Immutavault operational health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml status
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
