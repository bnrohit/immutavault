[Unit]
Description=Immutavault root-only retention/prune
After=immutavault-rest-server.service

[Service]
UMask=0077
Type=oneshot
User=root
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml retention
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
