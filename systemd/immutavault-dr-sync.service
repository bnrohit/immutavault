[Unit]
Description=Immutavault off-site DR recovery-point sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml dr-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
