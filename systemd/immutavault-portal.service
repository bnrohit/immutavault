[Unit]
Description=Immutavault self-service recovery portal
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
UMask=0077
Type=simple
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml portal
Restart=always
RestartSec=2
# FUSE3 fusermount is commonly setuid-root. no_new_privs would block the
# kernel mount helper even though the portal itself remains User=immutavault.
NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=false
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
