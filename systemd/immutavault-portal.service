[Unit]
Description=Immutavault unified enterprise management and recovery portal
After=network-online.target immutavault-flr.service immutavault-management.service
Wants=network-online.target immutavault-flr.service immutavault-management.service
StartLimitIntervalSec=0

[Service]
UMask=0077
Type=simple
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml portal
Restart=always
RestartSec=2
# The network-facing portal has no mount/configuration privilege. FUSE and
# configuration/systemd mutations live behind local SO_PEERCRED Unix brokers.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
