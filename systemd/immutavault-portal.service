[Unit]
Description=Immutavault self-service recovery portal
After=network-online.target immutavault-flr.service
Wants=network-online.target immutavault-flr.service
StartLimitIntervalSec=0

[Service]
UMask=0077
Type=simple
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml portal
Restart=always
RestartSec=2
# The portal is network-facing and never mounts recovery filesystems itself.
# FUSE/libguestfs operations are isolated in immutavault-flr.service.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
