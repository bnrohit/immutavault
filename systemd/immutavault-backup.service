[Unit]
Description=Immutavault daily VM backup
After=network-online.target immutavault-rest-server.service
Wants=network-online.target

[Service]
UMask=0077
Type=oneshot
User=immutavault
Group=immutavault
EnvironmentFile=/etc/immutavault/immutavault.env
ExecStart=/usr/local/bin/immutavault --config /etc/immutavault/immutavault.yml backup --all
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
