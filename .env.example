# Primary repository encryption key. Store a protected offline copy.
RESTIC_PASSWORD=replace-with-a-long-random-repository-password

# Append-only HTTPS writer. This identity must NOT have prune/delete authority.
REST_SERVER_USER=backupwriter
REST_SERVER_PASSWORD=replace-with-a-long-random-http-password

# Recovery portal bearer tokens. Generate independently.
IMMUTAVAULT_CUSTOMER_TOKEN=replace-with-random-customer-token
IMMUTAVAULT_APPROVER_TOKEN=replace-with-random-approver-token
IMMUTAVAULT_ADMIN_TOKEN=replace-with-random-admin-token

# Optional replica repository key
RESTIC_DR_PASSWORD=replace-with-a-different-long-random-password

# VMware/vCenter (govc reads these)
GOVC_URL=https://vcenter.example.local/sdk
GOVC_USERNAME=svc_immutavault@example.local
GOVC_PASSWORD=replace-me
GOVC_INSECURE=false

# Optional per-platform SSH identity
IMMUTAVAULT_SSH_KEY=/etc/immutavault/id_ed25519

# Optional S3 / NAS replica repository passwords and provider credentials.
# Use a different restic repository encryption password per replica.
RESTIC_WASABI_PASSWORD=replace-me
WASABI_ACCESS_KEY_ID=replace-me
WASABI_SECRET_ACCESS_KEY=replace-me
RESTIC_IDRIVE_PASSWORD=replace-me
IDRIVE_E2_ACCESS_KEY_ID=replace-me
IDRIVE_E2_SECRET_ACCESS_KEY=replace-me
RESTIC_B2_PASSWORD=replace-me
B2_S3_ACCESS_KEY_ID=replace-me
B2_S3_SECRET_ACCESS_KEY=replace-me
RESTIC_R2_PASSWORD=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
RESTIC_NAS_PASSWORD=replace-me

# Optional Cloudflare R2 Bucket Lock administration.
# Use these only for replica-lock-init/status; keep the edit token out of the regular backup service when possible.
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-with-dedicated-r2-bucket-config-token
